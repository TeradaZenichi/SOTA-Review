@ARTICLE{González-Garrido2024,
	author = {González-Garrido, Amaia and González-Pérez, M. and Asensio, F. J. and Cortés Borray, Andrés Felipe and Santos-Mugica, Maider and Vicente-Figueirido, Ibon},
