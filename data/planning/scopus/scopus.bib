	keywords = {Charging (batteries); Electric load flow; Electric power distribution; Electric vehicles; Particle swarm optimization (PSO); Renewable energy resources; Vehicle-to-grid; Bi-directional; Bi-directional power flow; Binary particle swarm optimization; Charging station; Electric vehicle charging; Electric vehicle charging station; Improved new binary particle swarm optimization; Optimum allotment; Power flows; Renewable energy integrations; Sensitivity analysis},
