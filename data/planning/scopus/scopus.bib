@ARTICLE{Yang20246345,
	author = {Yang, Xiaoying and Cui, Tianxiang and Wang, Hongru and Ye, Yujian},
	title = {Multiagent Deep Reinforcement Learning for Electric Vehicle Fast Charging Station Pricing Game in Electricity-Transportation Nexus},
	year = {2024},
	journal = {IEEE Transactions on Industrial Informatics},
	volume = {20},
	number = {4},
	pages = {6345 - 6355},
	doi = {10.1109/TII.2023.3345457},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85182364927&doi=10.1109%2FTII.2023.3345457&partnerID=40&md5=3a7454871dba292f5b98aa6f80d482af},
	affiliations = {University of Nottingham Ningbo China, School of Computer Science, Ningbo, Zhejiang, China; Southeast University, School of Electrical Engineering, Nanjing, Jiangsu, China},
	abstract = {Transportation electrification, involving large-scale integration of electric vehicles (EV) and fast charging stations (FCS), constitutes one of the key enablers toward decarbonization. Coordination of EV charging routes and demand through suitably designed price signals constitutes an imperative step in secure and economic operation of the coupled transportation network (TN) and power distribution network (PDN). In this work, we model the noncooperative pricing game of self-interested FCSs, taking into account the complex interactions between the EV users and the coupled operation of TN and PND. The uncertainties stemming from the EV users' cost elasticity and their travel energy requirements are encapsulated in the modeling of the TN, while the power flows in the PDN are coordinated considering the penetration of renewable energy sources. A modified multiagent proximal policy optimization method is developed to solve the pricing game. It employs an attention mechanism to selectively incorporate agents' representative information for estimating the Q-values. As such, it not only mitigates the nonstationary effect without exploding the input of the centralized critic but also safeguards the business confidentiality of FCSs. Moreover, a sequential updating scheme is used to ensure policy monotonic improvement and a Bayesian inference technique is adopted to enhance the robustness of the pricing strategy. Case studies on a large-scale test CTPN system reveal that the proposed method facilitates sufficient competition among FCSs, which is able to drive down the average charging prices for EV users. It also smooths out the spatial distribution of EV charging demands, which reduces the traffic congestions in the TN while enhancing the wind absorption and cost efficiency of the PDN. © 2005-2012 IEEE.},
	author_keywords = {Coupled power-transportation network (TN); electric vehicles (EVs); fast charging station (FCS); multiagent reinforcement learning (MARL); pricing game analysis; uncertainty; user equilibrium (UE)},
	keywords = {Bayesian networks; Behavioral research; Charging (batteries); Deep learning; Electric loads; Electric vehicles; Fertilizers; Multi agent systems; Reinforcement learning; Renewable energy resources; Traffic congestion; Uncertainty analysis; Behavioral science; Coupled power; Coupled power-transportation network; Electric vehicle; Electric vehicle charging; Fast charging station; Fast charging stations; Game; Game analysis; Multi-agent reinforcement learning; Multiagent reinforcement learning; Optimisations; Pricing game analyse; Pricing games; Transportation network; Uncertainty; User equilibrium; Costs},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 40}
}

