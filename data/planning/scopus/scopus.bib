@ARTICLE{Zhang20216756,
	author = {Zhang, Xingsong and Xu, Yangyang and Lu, Shengnan and Lu, Cheng and Guo, Yunxiang},
	title = {Joint Planning of Distributed PV Stations and EV Charging Stations in the Distribution Systems Based on Chance-Constrained Programming},
	year = {2021},
	journal = {IEEE Access},
	volume = {9},
	pages = {6756 - 6768},
	doi = {10.1109/ACCESS.2021.3049568},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85099243661&doi=10.1109%2FACCESS.2021.3049568&partnerID=40&md5=f4663953afb7fc34bd9e069b7ed3fa93},
	affiliations = {Nantong University, College of Electrical Engineering, Nantong, Jiangsu, China},
	abstract = {Simultaneous deployment of the electric vehicle charging stations (EVCSs) and distributed photovoltaic stations (DPVSs) in the distribution systems is an effective way to reduce greenhouse gas emissions, promote renewable power adoption, and achieve sustainable development in energy utilization. In this context, how to deploy the EVCSs and DPVSs in the distribution systems with a reasonable scheme is of great importance. In this article, a joint planning model is developed to optimize locations and capacities of the EVCSs and DPVSs simultaneously to reduce energy losses in the distribution systems. In the joint planning model, constraints on bus voltage deviations and line currents are both formulated as chance constraints to ensure that the distribution systems are in reasonable operating statues. To quantify these two chance constraints, a scenario-based method is developed to calculate the probabilistic power flow of the distribution systems during a typical planning day, in which random characters of the DPVS generations and the EVCS charging loads are both considered. The joint planning model of the EVCSs and DPVSs developed in this article is difficult to be solved by mathematical optimization methods. Therefore, genetic algorithm (GA) is customized and utilized to solve the joint planning model of the EVCSs and DPVSs. Finally, a case study based on IEEE 33-bus distribution systems validates the joint planning model and its solving algorithm. © 2013 IEEE.},
	author_keywords = {chance constraints; distributed photovoltaic station; Electric vehicle charging station; genetic algorithm; joint planning},
	keywords = {Charging (batteries); Computer programming; Distributed computer systems; Electric load flow; Energy dissipation; Energy utilization; Gas emissions; Genetic algorithms; Greenhouse gases; Probability distributions; Chance constraint; Chance-constrained programming; Distribution systems; Electric vehicle charging; Ev charging stations; Mathematical optimizations; Probabilistic power flow; Scenario-based methods; Electric power distribution},
	type = {Article},
