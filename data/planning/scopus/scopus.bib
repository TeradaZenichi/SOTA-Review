@ARTICLE{Ma2019,
	author = {Ma, Yiju and Azuatalam, Donald T. and Power, Thomas and Chapman, Archie C. and Verbič, Gregor},
	title = {A novel probabilistic framework to study the impact of photovoltaic-battery systems on low-voltage distribution networks},
	year = {2019},
