@ARTICLE{Lei20251847,
	author = {Lei, Chao and Wei, Nengqiao and Wang, Qianggang and Zou, Yao and Mo, Fuxue and Bu, Siqi and Li, Shuangqi and Chen, Bo and Goel, Lalit Kumar},
	title = {Load Transfer Optimization With Graph Characterizations on Multiple Time-Scales for Multi-Voltage Distribution Networks Against Overload Cascades},
