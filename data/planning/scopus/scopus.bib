@ARTICLE{Esmaeel Nezhad2025112867,
	author = {Esmaeel Nezhad, Ali and Sabour, Toktam Tavakkoli and Joshi, Ravindra Prabhakar and Sadegh Javadi, Mohammad and Nardelli, Pedro Henrique Juliano},
	title = {Optimal Operation of Electric Vehicle Supply Equipment by Aggregators in Local Energy Community},
	year = {2025},
