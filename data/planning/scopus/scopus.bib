	author = {Jin, Chencong and Wang, Zhenxia and Li, Xin},
	title = {A cost-based optimal placement and determination of capacitor, renewable energy units, and parking lots in power systems},
	year = {2025},
	journal = {Journal of Energy Storage},
	volume = {123},
	pages = {},
	doi = {10.1016/j.est.2025.116781},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003860684&doi=10.1016%2Fj.est.2025.116781&partnerID=40&md5=02af9196bcae93840b595aa595509ec1},
	affiliations = {Hebei Vocational University of Technology and Engineering, Xingtai, Hebei, China},
	abstract = {The integration of Renewable Energy Sources (RESs) into power grids has become increasingly important, prompting the need to address their inherent uncertainty and impact on grid performance. Energy Storage Systems (ESS) play a critical role in mitigating fluctuations in RES output. This study evaluates the technical and economic effects of integrating RESs and ESSs into the power system under different scenarios. The first case examines the base system without RES/ESS (base case). The second case incorporates optimal capacitor placement. In the third case, RES units are introduced, followed by the integration of Electric Vehicle (EV) parking lots with optimal capacity determination in the fourth scenario. Three sub-scenarios assess the role of EV batteries, considering financial efficiency, RES output fluctuation smoothing, and load profile optimization. The findings highlight the positive impact of batteries across all cases. In the first scenario, EV batteries provide significant cost benefits for owners. In the second, they assist in managing RES penetration while mitigating adverse effects. The third scenario demonstrates improvements in power quality and grid stability, ensuring reliable power during peak demand and reducing dependence on the upstream network. Key contributions include the optimal placement and planning of capacitors, RES units, and EV parking lots in distribution systems, which reduce power loss costs and improve voltage profiles. The results indicate a 76 % reduction in the cost of power losses when using capacitors, RES units, and EVs compared to the base case. The cost of active power purchased from the upstream network decreases by approximately 24 % in the third case, with reductions of 0 % and 20 % in the second and third cases, respectively. For policymakers and industry practitioners, the study recommends prioritizing the strategic placement of ESS, RES, and EV infrastructure to enhance grid resilience and operational efficiency, as well as to optimize financial returns from RES integration. © 2025 Elsevier Ltd},
	author_keywords = {Capacitor; Electrical vehicle; Energy storage; Optimal placement; Renewable energy},
	keywords = {Battery storage; Capacitor storage; Cost benefit analysis; Hydroelectric power; Smart power grids; Virtual storage; Wind power integration; Electric vehicle batteries; Electrical vehicles; Energy; Optimal placements; Parking lots; Power; Renewable energies; Renewable energy source; Storage systems; Vehicle parking; Solar fuels},
	type = {Article},
