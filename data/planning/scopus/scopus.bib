@ARTICLE{Bragatto2025,
	author = {Bragatto, T. and Bucarelli, Marco Antonio and Carere, Federico and Cresta, Massimo and Gatta, Fabiom Massimo and Geri, Alberto and MacCioni, Marco and Nati, Ludovico and Paulucci, Marco},
	title = {Assessing the Impact of Ultrafast Charging Stations on Distribution and Sub-Transmission Networks},
	year = {2025},
	journal = {IEEE Transactions on Industry Applications},
	pages = {},
	doi = {10.1109/TIA.2025.3600208},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014164937&doi=10.1109%2FTIA.2025.3600208&partnerID=40&md5=a66799eb989478025331b58ca772d8b9},
	affiliations = {Sapienza Università di Roma, Electrical and Energy Engineering, Rome, RM, Italy; Terni Distribuzione Elettrica, Terni, Italy; Terni Distribuzione Elettrica, Terni, Italy},
	abstract = {The growing adoption of electric vehicles (EVs) is driving the demand for public charging infrastructure, including ultrafast charging stations (UFCS) with power ratings exceeding 100 kW. However, the rapid expansion of public charging infrastructure necessitates appropriate network reinforcements and strategic development plans from grid operators. In this context, this paper provides an analysis of the impact of UFCS on existing sub-transmission and distribution networks. The study employs a methodology to assess hosting capacity and grid reinforcements in relation to UFCS, validating the results against stochastic variations in UFCS power demand. The research evaluates the effects of widespread UFCS deployment on both an existing distribution network (DN) and a sub-transmission network (SN), examining three distinct electric mobility development scenarios. The findings reveal that public charging infrastructure could significantly increase the load on distribution networks, necessitating the identified grid reinforcements to ensure secure grid operation. In the case of the SN, the results indicate that the current hosting capacity is sufficient to accommodate the medium-term development of public charging infrastructure. © 1972-2012 IEEE.},
	author_keywords = {Charging Infrastructure; Distribution Networks; Grid Reinforcements; Hosting Capacity; Ultra Fast Charging Stations},
