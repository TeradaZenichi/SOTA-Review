@ARTICLE{Diaz-Cachinero2025,
	author = {Diaz-Cachinero, Pablo and Contreras, Javier Mariano Paniagua and Muñoz-Hernandez, Jose Ignacio and Pourakbari Kasmaei, Mahdi and Lehtonen, Matti I.},
	title = {Electric vehicle routing and charging management in road transportation and power distribution systems: An iterative multistage approach},
	year = {2025},
	journal = {Expert Systems with Applications},
	volume = {290},
	pages = {},
	doi = {10.1016/j.eswa.2025.128274},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007505044&doi=10.1016%2Fj.eswa.2025.128274&partnerID=40&md5=0e055cc09e4470fb08367cd84357835f},
	affiliations = {Universidad Carlos III de Madrid, Department of Statistics, Getafe, Madrid, Spain; Universidad de Castilla-La Mancha, Escuela Técnica Superior de Ingeniería Industrial, Ciudad Real, Castile-La Mancha, Spain; Universidad de Castilla-La Mancha, Ciudad Real, Castile-La Mancha, Spain; Aalto University, Department of Electrical Engineering and Automation, Espoo, Uusimaa, Finland},
	abstract = {Electric vehicles offer a promising alternative to traditional fuel-powered vehicles due to their zero-emission feature, reduced maintenance needs, etc. Furthermore, the increasing demand for parcel delivery poses challenges for EV transportation to meet the requirements of e-commerce. As more electric vehicles hit the road, the relationship between road transportation and power distribution systems becomes increasingly important to manage power demand. This paper presents a novel multistage model that links EV delivery routing and EV charging energy management by considering the constraints of road transportation and power distribution systems. Requirements of EV operation and parcel delivery are considered for EV routing and charging. The power distribution system operation is modeled via a linearized AC power flow model, including generators, baseload demand, etc. In this work, an EV demand aggregator aims to find the best solution in terms of cost/profits by modifying the EV routing through the application of incentives for availability time and charging EVs at the lowest distribution locational marginal prices. To facilitate the resolution of such a complex problem in large-scale case studies, the proposed model is decomposed into three iterative stages. In the first stage, the delivery allocation and detailed delivery routing of EVs are addressed by minimizing the traveled distance and operating costs, respectively. In the second stage, the interconnection between the road transportation and power distribution systems is iteratively developed. This is done by adapting EV routing results to time periods and sending them to the EV demand aggregator, and calculating incentives for availability time based on distribution locational marginal prices and estimated power limits at charging points. Finally, the third stage is represented as a bi-level programming model. At the upper level, the EV demand aggregator determines the best charging strategy by minimizing charging costs based on the distribution locational marginal price derived from the lower-level problem. The lower-level problem involves a locational marginal pricing-based market clearing process where the total operation cost of the power distribution system is minimized. The numerical findings provide evidence for the efficacy of the proposed model on a practical 284-intersection map and a 119-bus power distribution system, using a fleet of 3000 vehicles in the base case study. The effectiveness of the proposed methodology is evaluated through three performance analyses that vary the number of EVs, renewable generation penetration levels, and electricity price profiles at the substation. These variations affect the DLMPs which are crucial for calculating incentives and directly influence the overall performance of the methodology. © 2025 The Author(s)},
	author_keywords = {Algorithms; Bi-level programming; Distribution locational marginal prices; Electric vehicle routing; Incentives for availability time; Problem decomposition},
	keywords = {Bus transportation; Electric buses; Highway administration; Linear programming; Navigation; Parking; Traffic control; Truck transportation; Vehicle performance; Vehicle routing; Bi-level programming; Distribution locational marginal price; Electric vehicle routing; Incentive for availability time; Locational marginal prices; Power-distribution system; Problem decomposition; Road transportation; Routings; Transportation distribution; Fleet operations},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Zheng2025,
	author = {Zheng, Chutao and Chen, Fawen and Xi, Zeli and Guo, Guowei and Yang, Xinsen and Chen, Cong},
	title = {A Resilience Entropy-Based Framework for V2G Charging Station Siting and Resilient Reconfiguration of Power Distribution Networks Under Disasters},
	year = {2025},
	journal = {World Electric Vehicle Journal},
	volume = {16},
	number = {9},
	pages = {},
	doi = {10.3390/wevj16090532},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016999086&doi=10.3390%2Fwevj16090532&partnerID=40&md5=5344425a53da5809391b39d93e662f3b},
	affiliations = {Guangdong Power Grid Corporation, Guangzhou, Guangdong, China},
	abstract = {In the post-disaster recovery of power distribution networks (PDNs), electric vehicles (EVs) possess a great potential as mobile energy storage units. When supported by vehicle-to-grid (V2G)-enabled charging stations, EVs can provide effective supplementary power for disaster-stricken areas. However, most existing stations only support unidirectional charging, limiting the resilience-enhancing potential of V2G. To address this gap, this paper proposes a resilience-oriented restoration optimization model that jointly considers the siting of V2G-enabled charging stations and PDN topology reconfiguration. A novel metric—Resilience Entropy—is introduced to dynamically characterize the recovery process. The model explicitly describes fault propagation and circuit breaker operations, while incorporating power flow and radial topology constraints to ensure secure operation. EV behavioral uncertainty is also considered to enhance model adaptability under real-world post-disaster conditions. The optimal siting scheme is obtained by solving the proposed model. Case studies demonstrate the model’s effectiveness in improving post-disaster supply and recovery efficiency, and analyze the impact of user participation willingness on V2G-based restoration. © 2025 by the authors.},
	author_keywords = {charging station siting; post-disaster restoration; power distribution network (PDN); resilience entropy; Vehicle-to-Grid (V2G)},
