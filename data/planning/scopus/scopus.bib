@ARTICLE{Gao20211099,
	author = {Gao, Xiang and De Carne, Giovanni and Andresen, Markus and Brüske, Sebastian and Pugliese, Sante and Liserre, Marco},
	title = {Voltage-Dependent Load-Leveling Approach by Means of Electric Vehicle Fast Charging Stations},
	year = {2021},
