}

@ARTICLE{Lu2025,
	author = {Lu, Junda and Yan, Xiangwu and Jia, Jiaoxin and Wang, Zehua and Wu, Weilin and Han, Lantu and Shao, Chen and Cai, Wenchao},
	title = {Two-Layer Planning of Rotary Power Flow Controller and Energy Router Considering Economy and Carrying Capacity of the Distribution Network},
	year = {2025},
	journal = {IET Generation, Transmission and Distribution},
	volume = {19},
	number = {1},
	pages = {},
	doi = {10.1049/gtd2.70174},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020378329&doi=10.1049%2Fgtd2.70174&partnerID=40&md5=7eaa01a0a690a0ed05b4f0035613d264},
	affiliations = {North China Electric Power University (Baoding), Baoding, Hebei, China; Hebei Agricultural University, College of Mechanical and Electrical Engineering, Baoding, Hebei, China; Inner Mongolia Electric Power Construction (Group) Company Limited, Hohhot, China},
	abstract = {With a high share of renewable energy and electric vehicle loads, distribution networks face insufficient carrying capacity due to structural weaknesses, reverse power flow, and weakened supply capability. Flexible interconnection devices optimize line power flow, while energy routers (ERs) regulate node-level power. Their combination effectively addresses these challenges. This paper proposes a two-layer planning method integrating the rotary power flow controller (RPFC) and ER across spatial and temporal dimensions to improve economy and carrying capacity. RPFC advantages over other flexible devices are analysed, and mathematical models for RPFC and ER are developed. The upper layer minimizes total network cost for siting and sizing, while the lower layer coordinates operation using indicators of stability, balance, economy, and flexibility. A hybrid optimization algorithm combining an improved gravitational field algorithm (IGFA) and second-order cone programming (SOCP) is introduced, incorporating a tent chaotic map and elite retention strategy. Simulation results show the method reduces network losses by 20.8% and increases carrying capacity by 15.9%. Compared with the GFA, the IGFA-SOCP improves convergence accuracy by 4.5% and reduces computation time by 42.4%, confirming the effectiveness of the proposed approach. © 2025 The Author(s). IET Generation, Transmission & Distribution published by John Wiley & Sons Ltd on behalf of The Institution of Engineering and Technology.},
	author_keywords = {power distribution; power distribution planning; power system interconnection; power system planning; power systems; power transmission economics; power transmission planning},
