@ARTICLE{Unterluggauer2026,
	author = {Unterluggauer, Tim and Hipolito, F. and Andersen, Peter Bach and Rich, Jeppe Husted and Marinelli, Mattia},
	title = {Conditional connection agreements for electric vehicle charging: Review, design, and implementation of solutions for the low-voltage power distribution grid},
	year = {2026},
	journal = {Renewable and Sustainable Energy Reviews},
	volume = {227},
	pages = {},
	doi = {10.1016/j.rser.2025.116427},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023127557&doi=10.1016%2Fj.rser.2025.116427&partnerID=40&md5=e8cc63627f93939dfd40461ff0970d64},
	affiliations = {Technical University of Denmark, Department of Wind and Energy Systems, Lyngby, Hovedstaden, Denmark; Technical University of Denmark, Department of Management Engineering, Lyngby, Hovedstaden, Denmark},
	abstract = {The ongoing electrification of society is placing increasing pressure on power distribution networks. As demand for new grid connections surges, distribution system operators face increasing challenges in providing network access, often necessitating costly and time-consuming grid reinforcements. These constraints highlight the need for short-term, cost-effective solutions that optimize the use of existing grid capacity while supporting continued electrification. Conditional connection agreements (CCAs) offer a promising mechanism to address this need; however, their deployment has so far been limited, primarily targeting medium- and high-voltage customers. This paper investigates the application of CCAs in the low-voltage grid, with a particular focus on electric vehicle (EV) charging. We first introduce a novel classification of CCA solutions based on the power allocation approach and conduct an in-depth review of the existing, albeit still nascent, EV-related literature. Subsequently, we propose four distinct solutions tailored for the low-voltage grid, developed through a real-world case study conducted in close collaboration with the Danish distribution system operator in the Municipality of Frederiksberg, Denmark. We explore the implementation of each solution, which was demonstrated at two public urban residential charging sites, and present the initial findings. Finally, we outline key implementation challenges and suggest directions for future research. © 2025 The Author(s)},
	author_keywords = {Charging infrastructure; Distribution system operator; Grid hosting capacity; Non-firm grid connection; Pilot demonstration; Power distribution network; Smart charging},
	keywords = {Charging (batteries); Electric power distribution; Electric power transmission networks; Electric utilities; Electric vehicles; Electrification; Power distribution networks; Vehicle-to-grid; Charging infrastructures; Distribution system operator; Distribution systems; Grid connections; Grid hosting capacity; Hosting capacity; Non-firm grid connection; Pilot demonstrations; Power distribution network; Smart charging; System operator; Cost effectiveness},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Yang2026,
	author = {Yang, Yue and Gao, Shan and Wang, Jianing and Huang, Xueliang},
	title = {A spatiotemporal coordinated regulation strategy for electric vehicles to enhance distribution network hosting capacity},
	year = {2026},
	journal = {Electric Power Systems Research},
	volume = {251},
	pages = {},
	doi = {10.1016/j.epsr.2025.112260},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016767029&doi=10.1016%2Fj.epsr.2025.112260&partnerID=40&md5=a6fab862b55189269d5313b3f47a5f0b},
	affiliations = {Southeast University, School of Electrical Engineering, Nanjing, Jiangsu, China},
	abstract = {To address the flexibility limitations and hosting capacity constraints of distribution network (DN) under large-scale electric vehicles (EVs) integration, this paper proposes a spatiotemporal coordinated regulation strategy. The strategy optimizes both time and space dimensions to leverage the regulation potential of different EV types. Temporally, a personalized charging/discharging schedule is generated for private EVs using an enhanced Proximal Policy Optimization (PPO) algorithm, with a soft projection mechanism ensuring strict adherence to safety constraints. Spatially, a utility-based charging station selection model is developed for taxis, and a differential evolution algorithm is employed to derive spatially differentiated pricing incentives, guiding the rational spatial distribution of taxis charging loads. Simulation results on the modified IEEE33 and IEEE123-bus systems demonstrate that the proposed spatiotemporal coordinated regulation strategy effectively enhances the distribution network hosting capacity (DNHC). © 2025},
	author_keywords = {Distribution network hosting capacity; Electric vehicles; improved PPO algorithm; Spatial discount pricing incentives; Spatiotemporal coordinated regulation},
	keywords = {Charging stations; Electric network parameters; Electric power distribution; Evolutionary algorithms; Optimization; Spatial distribution; Capacity constraints; Discount pricing; Distribution network hosting capacity; Hosting capacity; Improved proximal policy optimization algorithm; Network hosting; Optimization algorithms; Policy optimization; Spatial discount pricing incentive; Spatiotemporal coordinated regulation; Electric vehicles},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chakraborty2026,
	author = {Chakraborty, Raj and Das, Priyanath N. and Das, Diptanu and Gope, Sadhan and Das, Punam},
	title = {A novel electric vehicle allocation index approach for EV charging station placement in radial distribution network},
	year = {2026},
	journal = {Computers and Electrical Engineering},
	volume = {129},
	pages = {},
	doi = {10.1016/j.compeleceng.2025.110774},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020973171&doi=10.1016%2Fj.compeleceng.2025.110774&partnerID=40&md5=81cb8b70b01306055272b524fb454160},
	affiliations = {National Institute of Technology, Agartala, Department of Electrical Engineering, Agartala, TR, India},
	abstract = {Electric Vehicles (EVs) are vital for sustainable development, aiming to reduce carbon emissions and conserve fossil fuels. Their adoption relies on a robust charging infrastructure. Strategic placement of EV Charging Stations (EVCS) is crucial to meet charging demands while minimizing impacts on the Radial Distribution Network (RDN). This work analyzes the IEEE 33 bus test system, dividing it into two zones for effective EVCS deployment. The EVCS placement is based on Bus Reliability Index (BRI) modelling to identify strong and weak buses. The impact of EVCS on parameters like Active Power Loss (APL), Reactive Power Loss (RPL), Reliability Indices (RI), and Voltage Deviation Index (VDI) is analyzed using the Backward Forward Sweep Power Flow (BFSPF) technique. The analysis indicates that placing EVCS on strong buses improves RI but increases losses and worsens voltage profiles at certain nodes. Conversely, placing EVCS on weak buses reduces losses but lowers RI and causes voltage profiles to drop below 0.9 p.u. at some nodes. To address these challenges, this paper proposes a novel Electric Vehicle Allocation Index (EVAI) strategy. The EVAI approach optimally allocates EVCS alongside Type-1 Distributed Generation (DG) by simultaneously minimizing indices of APL, RPL, VDI, and RI. The Symbiotic Organisms Search (SOS) algorithm is applied to solve the optimization problem. The outcomes are validated using the Grey Wolf Optimizer (GWO) and Whale Optimization Algorithm (WOA). The Friedman test assesses the robustness of the proposed solution. The proposed solution indicates that minimizing EVAI ensures a more practical and efficient EVCS placement strategy. © 2025 Elsevier Ltd.},
	author_keywords = {Bus reliability index; Distributed generation; Electric vehicle allocation index; Electric vehicle charging stations; Optimization; Radial distribution network},
	keywords = {Buses; Charging (batteries); Charging stations; Distributed power generation; Electric network parameters; Electric vehicles; Fossil fuels; Reactive power; Reliability; Bus reliability index; Charging station; Electric vehicle allocation index; Electric vehicle charging; Electric vehicle charging station; EV Charging; Optimisations; Radial distribution networks; Reliability Index; Vehicle allocation; Optimization},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ahmed2026,
	author = {Ahmed, Fahim and Ahmad, Shameem and Rahman, Mir Toufikur and Rifat Hazari, Md Rifat and Faiz, Rethwan and Ahmed, Tofael and Karimi, Mazaher},
	title = {A holistic review of electric vehicle charging impacts on power distribution networks: Technical challenges, smart mitigation strategies and future directions},
	year = {2026},
	journal = {Applied Energy},
	volume = {402},
	pages = {},
	doi = {10.1016/j.apenergy.2025.126961},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020661617&doi=10.1016%2Fj.apenergy.2025.126961&partnerID=40&md5=568bc375c4ea63d3198621d2f6df40b1},
	affiliations = {American International University - Bangladesh, Department of Electrical and Electronic Engineering, Dhaka, Bangladesh; BRAC University, Department of Electrical and Electronic Engineering, Dhaka, Bangladesh; RMIT University, School of Engineering, Melbourne, VIC, Australia; Middleton Group Engineering Pty Ltd, Melbourne, VIC, Australia; Chittagong University of Engineering and Technology, Department of Electrical and Electronic Engineering, Chittagong, Bangladesh; Vaasan Yliopisto, School of Technology and Innovations, Vaasa, Ostrobothnia, Finland},
	abstract = {Electric Vehicles (EVs) have emerged as a pivotal solution in the global transition toward sustainable transportation, offering significant reductions in greenhouse gas emissions and dependence on fossil fuels. The growing adoption of EVs is anticipated to significantly influence electrical power distribution networks. As EV adoption accelerates worldwide, their integration into existing electrical distribution networks poses considerable challenges, particularly concerning load demand, voltage stability. Recent research has increasingly focused on understanding and mitigating these impacts, through a wide array of analytical, simulation-based, and data-driven methods both with and without the implementation of network management strategies. However, a comprehensive, integrated synthesis of these studies linking technical findings with mitigation strategies and practical implications is still limited. Additionally, there is a lack of a thorough review consolidating the existing research on this subject, which is essential for understanding the scope of prior studies. Motivated by this gap, this review paper provides a critical and consolidated examination of the current literature on the impacts of EV on distribution networks. The paper's objective is to assess the comprehensive effects of EV integration and evaluate mitigation strategies across three core domains: network management, EV and Distributed generation (DG) coordination, and regulated charging solutions. The paper also introduces the role of artificial intelligence in enabling predictive, adaptive, and scalable solutions. It highlights key methodologies, data sources, modeling approaches, and the efficacy of various solutions while identifying prevailing research gaps and future directions, including real-time co-simulation, techno-economic assessments, and hybrid planning frameworks. Key outcomes of this study include a unified framework for understanding EV interactions with the grid and distribution network, a comparative analysis of mitigation approaches, and a set of recommendations for advancing research and deployment strategies. These findings aim to inform stakeholders about the latest advancements and support decision-making. The findings are particularly beneficial for utility providers, network planners, policymakers, charging infrastructure developers, and researchers seeking to develop robust, data-informed strategies for managing EV impacts and guide them in addressing unresolved challenges. © 2025 The Authors},
	author_keywords = {AI for EV charging; Electric vehicles; EV charging; Hosting capacity; Load demand; Network management; Thermal capacity; Voltage stability},
	keywords = {Charging (batteries); Decision making; Electric load distribution; Electric network parameters; Electric power distribution; Electric power transmission networks; Electric vehicles; Greenhouse gases; Information management; Power distribution networks; AI for electric vehicle charging; Electric vehicle charging; Hosting capacity; Load demand; Mitigation strategy; Networks management; Power distribution network; Technical challenges; Thermal; Network management; artificial intelligence; electric vehicle; electrical power; fossil fuel; greenhouse gas; mitigation},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Angkasa2026,
	author = {Angkasa, Fahmi Firdaus and Goncalves Givisiez, Arthur and Liu, Michael Z. and Ochoa, Luis Nando and Gutierrez-Lagos, Luis and Kaloudas, Christos G.},
	title = {Designing future residential LV networks with EVs and PVs: a bi-period OPF-based approach},
	year = {2026},
	journal = {Electric Power Systems Research},
	volume = {250},
	pages = {},
	doi = {10.1016/j.epsr.2025.112109},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013546302&doi=10.1016%2Fj.epsr.2025.112109&partnerID=40&md5=396ea0d0ee60c3018be2a5c8d91d5eb1},
	affiliations = {University of Melbourne, Department of Electrical and Electronic Engineering, Melbourne, VIC, Australia; Universidad Adolfo Ibáñez, Faculty of Science and Engineering, Santiago, RM, Chile; SP Electricity North West, Stockport, United Kingdom},
	abstract = {The proliferation of electric vehicles (EVs) and residential photovoltaic (PV) systems in three-phase low voltage (LV) networks is prompting the need for cost-effective designs in brand-new neighborhoods that address the challenges of managing voltage (drop/rise) and asset congestion. This requires selecting the most appropriate conductors, transformers, and voltage regulation devices, which becomes a complex combinatorial problem. This paper proposes a bi-period three-phase AC Optimal Power Flow methodology to minimize asset costs while capturing the time-dependent impacts of EVs, PVs, and the locational effects on the transformer's primary voltage. The proposed approach is demonstrated using two realistic residential Australian LV networks: one having a single circuit with 31 houses, and another having multiple circuits with 89 houses. The approach identified optimal designs for both networks that minimize costs addressing the technical challenges. For single-circuit networks, off-load tap changers with thicker conductors is the most cost-effective design for both close and distant locations (relative to the primary substation). However, in multi-circuit networks, particularly in distant locations with significant voltage variations, on-load tap changers with thinner conductors is the most cost-effective design. These findings highlight the importance of considering individual network characteristics to optimally design brand-new LV networks with EVs and PVs. © 2025 The Author(s)},
	author_keywords = {Conductor sizing; Distribution network planning; Electric vehicle; Optimal power flow; Residential photovoltaic system; Tap changer},
	keywords = {Cost effectiveness; Electric load flow; Electric network parameters; Electric power distribution; Housing; Location; Optimal systems; Voltage control; Voltage regulators; Conductor sizing; Cost effective design; Distribution networks planning; Low-voltage networks; Optimal power flows; Photovoltaic systems; Residential photovoltaic; Residential photovoltaic system; Tap changers; Three phasis; Electric vehicles},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Liao2025,
	author = {Liao, Wenjun and Yang, Jianjun and Cai, Yun and Tan, Zhengping and Cui, Lei},
	title = {Intelligent energy management: sizing and locating microgrids with hybrid electric vehicle and supercapacitor-battery hybrid energy storage},
	year = {2025},
	journal = {Journal of Energy Storage},
	volume = {139},
	pages = {},
	doi = {10.1016/j.est.2025.118849},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018911990&doi=10.1016%2Fj.est.2025.118849&partnerID=40&md5=6f7b1ca6d1b4bc36529ffe94d8ac7b9b},
	affiliations = {Xihua University, Vehicle Measurement, Chengdu, Sichuan, China},
	abstract = {The article focuses on the combined application of distributed generation, cutting-edge energy storage, and electric vehicles in cooperative microgrids, which are an essential part of intelligent electricity distribution networks. The paper presents the innovative use of a recompression supercritical CO₂ (S-CO₂) Brayton cycle with an ejector as a storage system to absorb the fluctuations of renewables and to extend system flexibility. The given optimization framework is capable of figuring out the best location and the right capacity of the microgrids, and, besides, it can perform a 24-h dynamic scheduling of electric vehicle charging rates. The electric vehicle uncertainties, including fleet size, travel distance, and stochastic charging behavior, are explicitly incorporated. Simulations of the IEEE-30 bus system validate the considerable technical and economic advantages. The optimal microgrid deployment leads to a reduction of active power losses of 0.467 MW (3.9 % reduction), and the voltage profiles are also improved, with all buses being within the ±5 % operational range. Coordinating electric vehicle scheduling, through cutting the consumption of electricity from the grid, achieves a reduction of daily operating costs of roughly 13 % which is a significant saving. Moreover, the S-CO₂ storage system allows for a quick response to sudden changes in demand and supply of electricity. Besides that, the decrease in energy losses is consistent with the non-production of ≈3000 tons of CO₂ emissions per year; thus, the proposal can be considered as a sustainable one. Such results show that the combination of microgrids, electric vehicles, and the application of advanced storage can largely accomplish the grid of the future in terms of efficiency, resilience, and environmental benefits. © 2025 Elsevier Ltd},
	author_keywords = {Electric vehicle; Microgrid; Optimization of charge speed; Renewable energy sources; Uncertainty},
	keywords = {Brayton cycle; Charging (batteries); Electric energy storage; Electric power distribution; Electric power transmission networks; Electric utilities; Energy management; Fleet operations; Hybrid vehicles; Microgrids; Operating costs; Renewable energy; % reductions; Electric vehicle batteries; Intelligent energy management; Microgrid; Optimisations; Optimization of charge speed; Renewable energy source; Storage systems; Supercritical; Uncertainty; Stochastic systems},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ji2025,
	author = {Ji, Ruihang and Niu, Mingbo and Ma, Shuai and Su, Hao},
	title = {Tri-level collaborative optimization strategy for coupled power and transportation networks considering energy scheduling of fast charging stations},
	year = {2025},
	journal = {Applied Energy},
	volume = {401},
	pages = {},
	doi = {10.1016/j.apenergy.2025.126806},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017961145&doi=10.1016%2Fj.apenergy.2025.126806&partnerID=40&md5=c3048f86708f928f4b8fce13e0bbbab5},
	affiliations = {Chang'an University, Internet of Vehicle2 to Road Low-Carbon Research Laboratory, Xi'an, Shaanxi, China},
	abstract = {The development of electric vehicles (EVs) has accelerated the integration with transportation network (TN) and power distribution network (PDN). The coupled transportation and power distribution network (CPTN) is expected to play a significant role in the future energy internet. Fast charging stations (FCSs) are critical nodes of the CPTN and are progressively transforming into microgrids that integrate renewable energy sources (RES). How to effectively achieve coordinated optimization of EV scheduling, FCS energy scheduling, and the operation of PDN remains a significant challenge. This paper proposes a tri-level collaborative optimization scheduling model for CPTN. First, a tri-level optimization framework is proposed. At the upper level, EV scheduling center determines selection and route of FCS for EV users based on dynamic pricing. At the middle level, FCSs optimize the energy scheduling and set charging and discharging prices, while at the lower level, the PDN optimizes power flow and updates distribution locational marginal pricing (DLMP). Second, an EV FCS selection and route optimization model that accounts for temperature effects and queue waiting time is developed. Additionally, FCS energy scheduling and pricing models for FCSs are proposed, alongside an alternating current optimal power flow (ACOPF) model for integrating FCSs into the PDN. Then, an iterative solution method combining the sine-cosine greater cane rat algorithm (SCGCRA) with optimal condition decomposition is proposed to solve the tri-level model through iterative processes. Finally, four different strategies are analyzed using real world road network cases. The results indicate that the proposed strategy can reduce the total EV cost by 36.18 %, decrease total carbon emissions by 7.36 %, lower the total cost of the PDN by 12.35 %, and increase charging station revenue by 19.09 %, thereby validating the effectiveness of the proposed strategy. © 2025 Elsevier Ltd},
	author_keywords = {Electric vehicles; Fast charging station; Microgrid scheduling; Optimal power flow; Transportation network; Tri-level optimization},
	keywords = {Charging (batteries); Costs; Electric load flow; Electric power distribution; Iterative methods; Microgrids; Motor transportation; Optimization; Renewable energy; Transportation routes; Energy; Fast charging stations; Microgrid; Microgrid scheduling; Optimal power flows; Optimisations; Power distribution network; Transportation network; Tri-level optimization; Vehicle scheduling; Electric vehicles; algorithm; decomposition analysis; electric vehicle; optimization; transportation system},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Li2025,
	author = {Li, Tiange and Zhang, Menglin and Hu, Zhijian and Wang, Xiaofei and Zhou, Yue and Yan, Mingyu},
	title = {Distributed cooperative scheduling for distribution network and smart charging hubs driven by unbalanced distribution locational marginal price},
	year = {2025},
	journal = {Applied Energy},
	volume = {401},
	pages = {},
	doi = {10.1016/j.apenergy.2025.126668},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014727587&doi=10.1016%2Fj.apenergy.2025.126668&partnerID=40&md5=cda6f181eb8fa1dfe330d396c2e6ffd8},
	affiliations = {Wuhan University, School of Electrical Engineering and Automation, Wuhan, Hubei, China; China University of Geosciences, School of Automation, Wuhan, Hubei, China; The University of Tennessee, Knoxville, Department of Electrical Engineering and Computer Sciences, Knoxville, TN, United States; Tianjin University, Tianjin, China; Huazhong University of Science and Technology, Wuhan, Hubei, China},
	abstract = {The low-carbon energy transition introduces new challenges to the operation of power distribution networks (PDN). In particular, the growing proliferation of single-phase loads and distributed renewable energies exacerbates three-phase imbalances within the PDN. The smart charging hub, as a low-carbon unit for transportation electrification, integrating photovoltaic (PV) generation, energy storage (ES), and electric vehicle (EV) charging infrastructure, processes phase-balancing capabilities by regulating the three-phase power. However, existing distribution markets lack effective mechanisms to incentivize the participation of PV-ES-EV integrated smart charging hubs (PEV-Hubs) in mitigating imbalances. This paper proposes a three-phase distribution locational marginal price (DLMP)-driven distributed optimization framework that coordinates PDN and PEV-Hubs to actively mitigate phase imbalances. A bi-level optimization model is formulated to capture the interaction between the distribution system operator (DSO) and PEV-Hubs. At the lower level, a three-phase distribution market clearing model is established based on the branch power flow model with voltage imbalance constraints, which can generate unbalanced DLMPs. At the upper level, PEV-Hubs optimize phase-to-phase power allocation to maximize revenue by taking unbalanced DLMP from the lower level as inputs. To solve the bi-level model, the Karush-Kuhn-Tucker (KKT) conditions and strong duality theory are employed to reformulate the bi-level problem into a single-level problem. A novel distributed solution method based on dual problem decomposition is then proposed for privacy protection. Simulation results on two different-scale systems confirm that the proposed method effectively limits the voltage imbalance in the PDN and enhances economic benefits for both the DSO and PEV-Hubs. Compared to the traditional iterative algorithms, the proposed distributed solution method exhibits better convergence and solution optimality. © 2025 Elsevier Ltd},
	author_keywords = {Distributed scheduling; Inverter-based flexibility; Smart charging hub; Three-phase imbalance; Unbalanced DLMP},
	keywords = {Charging (batteries); Electric power distribution; Embedded systems; Power markets; Distributed scheduling; Inverter-based; Inverter-based flexibility; Locational marginal prices; Phase imbalances; Smart charging; Smart charging hub; Three phase; Three phasis; Three-phase imbalance; Unbalanced distribution; Unbalanced distribution locational marginal price; Iterative methods; decomposition; distribution system; electric vehicle; energy market; energy storage; optimization},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Soliman2025,
	author = {Soliman, Ismail A. and Tulsky, V. and Abd El-Ghany, Hossam A. and Azmy, Ahmed M.},
	title = {Optimizing hosting capacity and spatial deployment of EV charging stations for V2G integration in zonal distribution networks},
	year = {2025},
	journal = {Applied Energy},
	volume = {401},
	pages = {},
	doi = {10.1016/j.apenergy.2025.126671},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013843186&doi=10.1016%2Fj.apenergy.2025.126671&partnerID=40&md5=92d33b1d348bf6d31be74a2678111586},
	affiliations = {Faculty of Engineering, Electrical Power and Machines Engineering Department, Tanta, Gharbia, Egypt; National Research University “Moscow Power Engineering Institute”, Electrical Power Systems Department, Moscow, Moscow Oblast, Russian Federation},
	abstract = {Establishing a robust network of electric vehicle charging stations (EVCSs) is a critical step in enabling convenient and reliable access to charging infrastructure, thereby accelerating the transition to sustainable transportation systems. However, the rapid expansion of EVCSs imposes additional loads on distribution networks, necessitating a thorough assessment of the hosting capacity that can be accommodated by the network without reducing its efficiency. This paper proposes a genetic algorithm-based multi-objective function to determine the optimal hosting capacity and spatial placement of EVCSs, alongside the spatial and temporal distribution and operation of V2G and their optimal power factors. By selecting optimal power factors, the proposed framework minimizes active and reactive power losses, while enhancing the system's voltage profile. The optimization objectives include minimizing total energy losses and maximizing power quality indices. Managing uncertainties in load demand and V2G operations represents significant challenges in maintaining power system stability and efficiency. Therefore, these uncertainties, along with system constraints, are carefully accounted for in the optimization process to ensure system stability and efficiency. The proposed framework is validated on benchmark distribution systems using MATLAB/Script, with regions divided into districts to simulate electric vehicles (EVs) distribution. The obtained results demonstrate the algorithm's robustness and reliability under various operational scenarios. © 2025 Elsevier Ltd},
	author_keywords = {Electric vehicle charging stations; Hosting capacity; Optimization algorithms; Power quality; Vehicle to grid},
	keywords = {Benchmarking; Charging (batteries); Charging stations; Electric network parameters; Electric power factor; Electric vehicles; Energy dissipation; Genetic algorithms; MATLAB; Outages; Reactive power; System stability; Charging station; Electric vehicle charging; Electric vehicle charging station; Hosting capacity; Optimal power factors; Optimisations; Optimization algorithms; Power; Robust network; Vehicle to grids; Power quality; algorithm; electric vehicle; optimization; temporal distribution},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Ebrahim20254540,
	author = {Ebrahim, M. A. and Ahmed, Esraa E. and Salama, Mohammed Moenes Mohamed and Ahmed, M. M.R.},
	title = {Enhancing electrical distribution network performance amidst rising electric vehicle integration},
	year = {2025},
	journal = {Energy Reports},
	volume = {14},
	pages = {4540 - 4559},
	doi = {10.1016/j.egyr.2025.11.055},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022839682&doi=10.1016%2Fj.egyr.2025.11.055&partnerID=40&md5=a05fed1d5bc82b75d8ee9fd5d247f004},
	affiliations = {Faculty of Engineering at Shoubra, Cairo, Cairo, Egypt; Faculty of Industrial Education, Department of Electrical Technology, Helwan, Cairo, Egypt},
	abstract = {The rapid growth in electric vehicle adoption presents both operational challenges and modernization opportunities for electrical distribution networks. As electric vehicles become more prevalent, their inherently unpredictable charging behavior can introduce issues such as voltage instability, feeder congestion, and elevated power losses, which threaten the overall reliability and efficiency of the grid. To address these emerging challenges, this study introduces an advanced optimization framework that leverages two recent metaheuristic algorithms: Sand Cat Swarm Optimization and Mexican Axolotl Optimization. The proposed approach focuses on identifying the optimal locations for distributed generation units and electric vehicle charging stations in distribution networks. A weighted multi-objective function is employed to minimize total active power losses, enhance voltage profiles, and reduce operational costs associated with network reinforcement. The methodology is validated on IEEE 14-bus, 33-bus, and 200-bus test systems to demonstrate scalability and robustness. Simulation results show that in the single distributed generation placement scenario, power losses are reduced by up to 73 % with Mexican Axolotl Optimization and 67 % with Sand Cat Swarm Optimization. In the multi-unit configuration, power losses decreased further by up to 76 % and 84 %, respectively. Across all test cases, voltage magnitudes at system buses remain within the standard operational range of 0.95–1.05 per unit, confirming effective voltage regulation. An additional uncertainty analysis highlighted the impact of renewable variability and load fluctuations on system stability. © 2025 The Authors.},
	author_keywords = {Distributed generations (DGs); Electric vehicle charging stations (EVCS); Electric vehicles (EVs); Electrical distribution networks; Mexican Axolotl Optimization (MAO); Power losses; Sand Cat Swarm Optimization (SCSO); Voltage profile},
	keywords = {Buses; Charging (batteries); Distributed power generation; Electric load distribution; Electric load loss; Electric network parameters; Electric power system stability; Electric vehicles; Outages; System buses; Voltage control; Charging station; Distributed generation; Electric vehicle; Electric vehicle charging; Electric vehicle charging station; Electrical distribution networks; Mexican axolotl optimization; Optimisations; Powerloss; Sand cat swarm optimization; Swarm optimization; Voltage profile; Electric losses; Voltage regulators},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

