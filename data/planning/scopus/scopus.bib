@ARTICLE{Elmallah2022,
	author = {Elmallah, Salma and Brockway, Anna M. and Callaway, Duncan S.},
	title = {Can distribution grid infrastructure accommodate residential electrification and electric vehicle adoption in Northern California?},
	year = {2022},
	journal = {Environmental Research: Infrastructure and Sustainability},
	volume = {2},
	number = {4},
	pages = {},
	doi = {10.1088/2634-4505/ac949c},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85153797633&doi=10.1088%2F2634-4505%2Fac949c&partnerID=40&md5=2388944878f07aa3279ca90bb32f1f23},
	affiliations = {Energy and Resources Group, Berkeley, CA, United States; University of California, Berkeley, Electrical Engineering & Computer Science Department, Berkeley, CA, United States; Lawrence Berkeley National Laboratory, Berkeley, CA, United States},
	abstract = {In this paper we ask: in what ways will utilities need to upgrade the electric distribution grid to accommodate electrified loads, and what will those upgrades cost? Our study focuses on the PG&E service area in Northern California, which serves 4.8 million electricity customers and is subject to aggressive targets for both EV adoption and electrification of residential space and water heating. We create spatio-temporally detailed electricity demand forecasts, and compare that demand to distribution infrastructure limits across a range of technology adoption scenarios. We find that electrification of residential space and water heating will lead to fewer impacts on distribution feeder capacity than EV charging, but that both transitions will require an acceleration of the current pace of upgrades. We also find that timing and location have a strong influence on total capacity additions in important ways: for example, scenarios that favor daytime EV charging have similar impacts to those with managed nighttime residential charging, but uncontrolled nighttime residential charging could have significantly larger impacts. We project that these upgrades will add at least $1 billion and potentially over $10 billion to PG&E’s rate base. We conclude that measures that enable the completion of a high number of upcoming upgrade projects—including addressing workforce and supply chain constraints, and pursuing non-wires alternatives like energy storage and demand response—are critical to successful electrification. © 2022 The Author(s). Published by IOP Publishing Ltd.},
	author_keywords = {distribution grid; electricity; electrification; energy; utilities},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 31; All Open Access; Gold Open Access}
}

@ARTICLE{Puppala202245,
	author = {Puppala, Ramesh and Koritala, Chandra Sekhar},
	title = {Optimal Allocation of Capacitor Banks and DSTATCOMs in Radial Distribution System Considering Electric Vehicle Load Growth},
	year = {2022},
	journal = {International Journal of Intelligent Engineering and Systems},
	volume = {15},
	number = {6},
	pages = {45 - 53},
	doi = {10.22266/ijies2022.1231.05},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140737416&doi=10.22266%2Fijies2022.1231.05&partnerID=40&md5=62275681533e9194223b193232748d5d},
	affiliations = {ANU College of Engineering & Technology, Department of Electrical and Electronic Engineering, Guntur, AP, India; R.V.R. & J.C.College of Engineering, Guntur, AP, India},
	abstract = {In this paper, an improved variant of nature-inspired meta-heuristic algorithm inspired by the pollination process of flowering plants called improved flower pollination algorithm (IFPA) is utilized for solving the optimal allocation of capacitor banks (CBs) and distribution-static synchronous compensator (DSTATCOM) problem considering electric vehicle (EV) load growth. In IFPA, a new double-direction learning strategy to advance local searching capacity, a novel dynamic switching probability method to balance global and local searching, and a new greedy technique to increase population diversity. A multi-objective function is formulated for minimizing the real power loss and installation cost of CBs/DSTATCOM. The search space of the multiple CBs/DSTATCOMs is primarily reduced using voltage stability index (VSI) and later the best locations and sizes of CBs/DSTATCOMs are determined by implementing IFPA. The proposed hybrid VSI-FPA approach is applied to solve the DSTATCOM allocation problem in standard IEEE 33-bus radial distribution systems (RDS). The effectiveness of the proposed approach is compared with the similar types of heuristic approaches in the literature. The comparative results shown that the IFPA is outperformed than other algorithms by providing minimum losses, reduced installation cost, and consequently improved voltage profile as well as voltage stability irrespective of EV load growth via allocating the CBs/DSTATCOM optimally in the RDS. The basic network profited from CBs and DSTATCOMs by a loss reduction of 34.71% and 29.50%, respectively, according to the results. The loss, on the other hand, increases to 88.69 percent when the network is filled with 50% EV load. With CBs and DSTATCOMs, however, the higher losses are just 37.07% and 37.26%, respectively. © 2022, International Journal of Intelligent Engineering and Systems. All Rights Reserved.},
	author_keywords = {Capacitor bank; Dstatcom; Electric vehicle load; Improved flower pollination algorithm; Loss minimization; Radial distribution system; Voltage stability index},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Bronze Open Access}
}

@ARTICLE{Toghranegar2022,
	author = {Toghranegar, Sina and Rabiee, Abbas and Soroudi, Alireza R.},
	title = {Enhancing the unbalanced distribution network's hosting capacity for DERs via optimal load re-phasing},
	year = {2022},
	journal = {Sustainable Cities and Society},
	volume = {87},
	pages = {},
	doi = {10.1016/j.scs.2022.104243},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85140435454&doi=10.1016%2Fj.scs.2022.104243&partnerID=40&md5=29945fe61f78af154521242fcf565e64},
	affiliations = {University of Zanjan, Department of Electrical Engineering, Zanjan, Zanjan, Iran; University College Dublin, School of Electrical and Electronic Engineering, Dublin, Leinster, Ireland},
	abstract = {Maximizing the distribution systems’ hosting capacity (HC) for distributed energy resources (DERs) is an integral part of the efforts to increase the share of renewable energy sources (RES) in electricity grids. Hence, a novel strategy is proposed in this paper to enhance the network's HC for DERs, which considers the technical issues such as voltage unbalance caused by the high share of DERs. Through a novel three-stage optimization model, this paper shows that the HC for DERs such as solar photo-voltaics (PV), residential and public electric vehicle chargers (EVCs), and heat pumps (HPs) can be increased. The proposed approach uses a novel re-phasing strategy to determine the optimal network configuration, which can decrease the voltage unbalance, and hence the available network capacity can accommodate more DERs. In the first stage, the network's HC for DERs is maximized without any further structural modifications on the existing network. In the second stage, the best configuration of the system is obtained to mitigate the voltage unbalance caused by the DER penetration. Finally, at the third stage and based on the obtained optimal configuration of the network, the HC of the modified system is maximized by adding more DER capacity. The results show that using the proposed re-phasing technique can improve the network's HC for DERs, without any need to reinforce the existing network. © 2022 Elsevier Ltd},
	author_keywords = {Electric vehicle (EV); Heat pump (HP); Hosting capacity (HC); Particle swarm optimization (PSO); Retrofit; Unbalanced distribution network},
	keywords = {Heat pump systems; Particle swarm optimization (PSO); Renewable energy resources; Electric vehicle; Heat pump; Heat pumps; Hosting capacity; Particle swarm; Particle swarm optimization; Retrofit; Swarm optimization; Unbalanced distribution networks; Electric vehicles; alternative energy; distribution system; electric vehicle; optimization},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 17}
}

