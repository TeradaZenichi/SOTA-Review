@ARTICLE{Chen202511075,
	author = {Chen, Jie and Zhang, Xiaodong and Zhou, Yuzhou and Chen, Ge and Zhai, Qiao Zhu and Cao, Yijia},
	title = {Optimal Joint Scheduling of Distribution Network and Electric Vehicle Tracks Considering Actual Carbon Emission Responsibility},
	year = {2025},
	journal = {IEEE Transactions on Transportation Electrification},
	volume = {11},
	number = {5},
	pages = {11075 - 11087},
	doi = {10.1109/TTE.2025.3570747},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005434130&doi=10.1109%2FTTE.2025.3570747&partnerID=40&md5=7bb27db99c3b4f2b0b79abb14e65f6f3},
	affiliations = {Xiangtan University, College of Automation and Electronic Information, Xiangtan, Hunan, China; Xi'an Jiaotong University, School of Automation Science and Engineering, Xi'an, Shaanxi, China; Academy of Mathematics and System Sciences Chinese Academy of Sciences, Beijing, China; Changsha University of Science and Technology, College of Electrical and Information Engineering, Changsha, Hunan, China},
	abstract = {With the increasing popularity of electric vehicles (EVs), on the energy supply side, large-scale grid-connected charging of EVs poses new challenges to the safe and economical operation of power distribution networks (PDNs). On the transportation side, EV tracks also have a significant impact on traffic congestion. Moreover, the division of carbon responsibilities for EVs is unclear, which seriously affects the long-term healthy development of carbon reduction strategies. Therefore, this article comprehensively considers EV charging scheduling and traffic trajectories and proposes a new joint optimization method for PDNs and EV tracks. Additionally, the method also takes into account the allocation of carbon emission responsibilities. Specifically, a three-layer iterative optimization framework is established. In the first layer, a carbon emission flow model is established based on the alternating current optimal power flow (ACOPF) framework, and price signals reflecting the carbon responsibility of each node are obtained. Then, using these price signals, the second layer employs evolutionary game theory to determine the charging prices at different nodes. In the third layer, a two-objective track optimization model is proposed to minimize operation cost and maximize traffic flow, and the charging demand of each node is fed back to the first layer until the iteration converges. Furthermore, an iterative algorithm is designed, driven by the Lagrangian function, the Bellman-Ford augmented path algorithm, and the Ford-Fulkerson maximum flow algorithm, to efficiently solve this problem. Numerical tests verify the effectiveness of the proposed methods in ensuring the safe and economical operation of PDNs and reducing carbon emissions. © 2015 IEEE.},
	author_keywords = {Carbon emission flow tracing; electric vehicles (EVs); evolutionary game; joint optimization of distribution network and transportation network},
	keywords = {Air traffic control; Tracked vehicles; Traffic congestion; Carbon emission flow tracing; Carbon emission flows; Carbon emissions; Economical operation; Evolutionary games; Joint optimization; Joint optimization of distribution network and transportation network; Power distribution network; Safe operation; Transportation network; Electric vehicles},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

