	title = {A distributionally robust calculation method for distribution network EV hosting capacity considering charging demand},
	year = {2025},
	journal = {International Journal of Electrical Power and Energy Systems},
	volume = {172},
	pages = {},
	doi = {10.1016/j.ijepes.2025.111342},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020905611&doi=10.1016%2Fj.ijepes.2025.111342&partnerID=40&md5=829e36c0c9dfe2d6bb0d3dfa32bbf95a},
	affiliations = {North China Electric Power University, Beijing, China},
	abstract = {The large-scale application of electric vehicles (EVs) challenges the safety and stability of distribution networks. However, it is difficult to accurately quantify and optimally distribute the EV hosting capacity due to factors such as road network coupling and fluctuations in photovoltaic (PV) output. This paper proposes a distributionally robust optimization (DRO) model considering the distribution of EV charging demand to calculate the distribution network EV hosting capacity. The road network is divided into functional zones and travel chains are constructed separately for different types of EVs. A semi-dynamic traffic assignment (SDTA) model is integrated into the travel chain framework for EV route selection. The travel demands are established based on the probability of state transitions, and the spatiotemporal distribution of charging demands is obtained. Then, a DRO model based on the Wasserstein metric addresses the uncertainty of PV output. This approach prioritizes the charging demand distribution and optimizes the capacity allocation of electric vehicle charging stations (EVCSs) to improve overall charging satisfaction. A case study on a coupled Nguyen-Dupuis road network and modified IEEE 33-bus system reveals that the proposed method achieves more accurate capacity allocation, fully exploiting the potential of the grid to host EVs. © 2025},
	author_keywords = {Charging demand modeling; Distribution network; Distributionally robust optimization (DRO); Electric vehicle hosting capacity; Road network},
	keywords = {Chains; Charge distribution; Charging (batteries); Charging stations; Electric network parameters; Electric power distribution; Electric vehicles; Intelligent vehicle highway systems; Motor transportation; Optimization; Probability distributions; Traffic control; Charging demand modeling; Charging demands; Demand modelling; Distributionally robust optimization; Electric vehicle hosting capacity; Hosting capacity; Photovoltaics; Road network; Robust optimization; Robust optimization models; Roads and streets},
	type = {Article},
