	author = {Bitencourt, Leonardo De A. and Dias, Bruno H. and Soares, Tiago André and Borba, Bruno S.M.C. and Quirós-Tortós, Jairo},
	title = {e-Carsharing siting and sizing DLMP-based under demand uncertainty},
	year = {2023},
	journal = {Applied Energy},
	volume = {330},
	pages = {},
	doi = {10.1016/j.apenergy.2022.120347},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85142679625&doi=10.1016%2Fj.apenergy.2022.120347&partnerID=40&md5=890a176fa6c51985bda28119489fc11d},
	affiliations = {Universidade Federal de Juiz de Fora, Juiz de Fora, MG, Brazil; Institute for Systems and Computer Engineering, Technology and Science, Porto, Porto, Portugal; Universidade Federal Fluminense, Niteroi, RJ, Brazil; Universidad de Costa Rica, San Jose, San Jose, Costa Rica},
	abstract = {Electric vehicle (EV) sales and shared mobility are increasing worldwide. Despite its challenges, e-carsharing has an opportunity to still profit in periods of low rental demand compared to traditional carsharing. The purpose of this paper is to assess the profitability of an e–carsharing company based on distribution local marginal price (DLMP) and vehicle-to-grid (V2G) that cooperates with the distribution system operator (DSO) through a two-stage stochastic model. The AC optimal power flow (ACOPF) is modeled using second-order cone programming (SOCP) linearized by the global polyhedral approximation. The IEEE 33 bus test system and a real Kernel distribution for the EV rental demands are used in four planning cases in the GAMS environment. The results indicate that the proposed methodology does not affect EV user satisfaction. Moreover, the planning disregarding the power grid perspective is the most profitable, but the operation may not be possible in real applications due to the high-power flows via V2G. Finally, the e–carsharing planning considering the DSO perspective increased the charging cost by 1.66 % but also reduced the DLMP peak, losses, and peak demand by 2.5 %, 1.5 %, and 5.1 %, respectively. One important conclusion is that the technical benefits brought to the DSO by the e–carsharing company could be turned into services and advantages for both agents, increasing profit and mitigating negative impacts, such as higher operational costs. © 2022 Elsevier Ltd},
