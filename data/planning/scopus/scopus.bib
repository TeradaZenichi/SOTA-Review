}

@ARTICLE{Yazdani2025,
	author = {Yazdani, Lida and Sepasian, Mohammad Sadegh and Arasteh, Hamidreza},
	title = {Optimal comprehensive planning for AC/DC hybrid distribution networks: Balancing cost, risk, and flexibility with variable RES installations},
	year = {2025},
	journal = {Electric Power Systems Research},
	volume = {246},
	pages = {},
	doi = {10.1016/j.epsr.2025.111703},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002587899&doi=10.1016%2Fj.epsr.2025.111703&partnerID=40&md5=b25285741441f8438a1da71ca1d58d75},
	affiliations = {Shahid Beheshti University, Tehran, Tehran, Iran; Niroo Research Institute, Power Systems Operation and Planning Research Department, Tehran, Tehran, Iran; Huanjiang Laboratory, Shaoxing, Zhejiang, China},
	abstract = {This study introduces a novel multi-objective optimization framework for planning AC/DC hybrid distribution networks (HDNs), addressing key challenges in cost minimization, risk reduction, and network flexibility. Unlike conventional approaches that primarily focus on cost, the proposed method explicitly accounts for the risk associated with variations in operating conditions due to uncertainties in load demand and distributed generation (DG) output. Additionally, it enhances the adaptability of network planning by considering flexibility in RES installation capacity as a decision variable. To manage these uncertainties, a Monte Carlo Simulation (MCS) generates diverse operating scenarios, which are refined through scenario reduction techniques to improve computational efficiency. A genetic algorithm (GA) determines the optimal HDN configuration, while the general algebraic modeling system (GAMS) computes the optimal power flow (OPF) for each scenario. A fuzzy satisfying method is applied to balance trade-offs between conflicting objectives. The proposed framework is validated through a comprehensive case study involving photovoltaic (PV) panels, wind-based DGs, and electric vehicle (EV) charging stations. Results demonstrate that the model effectively minimizes costs, mitigates the risk of operational uncertainties, and enhances planning flexibility, ensuring a robust HDN configuration under both short- and long-term uncertainties. © 2025 Elsevier B.V.},
	author_keywords = {AC/DC networks; Multi-Objective optimization; Renewable energy sources (RESs); Risk; Uncertainty; Voltage source converter (VSC)},
	keywords = {Multiobjective optimization; Power distribution networks; AC/DC network; Comprehensive planning; DC networks; Distribution network configuration; Multi-objectives optimization; Renewable energy source; Uncertainty; Voltage source; Voltage source converter; DC distribution systems},
