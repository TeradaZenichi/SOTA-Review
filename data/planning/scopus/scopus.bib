@ARTICLE{Rashnu2025,
	author = {Rashnu, Naser and Mozafari, Babak and Sharifi, Reza},
	title = {Optimization of distribution networks using quantum annealing for loss reduction and voltage improvement in electrical vehicle parking management},
	year = {2025},
	journal = {Results in Engineering},
	volume = {27},
	pages = {},
	doi = {10.1016/j.rineng.2025.105733},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105008805132&doi=10.1016%2Fj.rineng.2025.105733&partnerID=40&md5=0dbb1edfccc4c614fd150cbff4e98b74},
	affiliations = {Islamic Azad University, Department of Electrical Engineering, Tehran, Tehran, Iran; Islamic Azad University, Department of Electrical Engineering, Tehran, Tehran, Iran},
	abstract = {This paper explores the integration of Electric Vehicle (EV) parking lots into power distribution networks (DNs) and proposes a quantum-based optimization framework to enhance grid performance. As EV and renewable energy source (RES) penetration increases, coordinated EV charging and discharging becomes critical for reducing power losses, improving voltage profiles, and supporting energy storage management. Traditional optimization techniques like Genetic Algorithms (GA) and Particle Swarm Optimization (PSO) often struggle with the nonlinear, high-dimensional nature of EV-grid interaction problems. In contrast, Quantum Annealing (QA) leverages quantum tunneling and parallelism to efficiently explore complex solution spaces. The proposed approach formulates the EV parking scheduling task as a Quadratic Unconstrained Binary Optimization (QUBO) problem, suitable for quantum processing. Simulation studies on IEEE 13-, 33-, and 69-bus systems show that QA significantly outperforms GA and PSO. Notably, in the 13-bus network, QA reduced power losses by 72.07 % and voltage deviation by 87.5 %; corresponding reductions in 33- and 69-bus systems were 42.1 % and 46.6 %, respectively. The results demonstrate the method's scalability and effectiveness in handling real-time EV integration while reducing operational costs and supporting voltage stability. From a societal perspective, the framework facilitates cleaner energy usage and more intelligent urban EV infrastructure planning. However, limitations include the reliance on quantum simulators (rather than physical hardware) and the assumption of deterministic EV behavior. Future research will investigate hybrid quantum-classical implementations and stochastic modeling using real-world data. Overall, this study presents a robust and scalable optimization strategy for building more efficient, resilient, and sustainable smart distribution systems. © 2025},
	author_keywords = {Distribution Network (DN); Electrical Vehicle (EV); Optimization Algorithms; Power Loss Reduction; Quantum Annealing (QA); Voltage Profile Improvement},
	keywords = {Digital storage; Electric losses; Electric network parameters; Electric power distribution; Quantum theory; Renewable energy; Stochastic models; Vehicles; Distribution network; Electrical vehicle; Electrical vehicles; Optimization algorithms; Power loss reduction; Powerloss; Quantum annealing; Vehicle parking; Voltage profile improvement; Particle swarm optimization (PSO); Stochastic systems},
	type = {Article},
