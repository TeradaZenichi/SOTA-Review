	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007146971&doi=10.1016%2Fj.apenergy.2025.126193&partnerID=40&md5=5e458b69b98778c9dc98472cfedd33e5},
	affiliations = {Concordia University, Montreal, QC, Canada; Monash University, Melbourne, VIC, Australia; Concordia University, Department of Building, Montreal, QC, Canada},
	abstract = {In today's world, more residential consumers are using distributed energy resources (DERs), including solar photovoltaic (PV) and other energy storage systems (ESSs), thanks to incentives. However, operating ESSs to maximize profits can cause power flows that may exceed voltage and thermal limits in distribution networks. This paper articulates an in-depth analysis of the relationship between smart home energy management systems (SHEMS), distribution transformers, and system constraints following a transactive energy framework. The main focuses are SHEMS, aggregators, peer-to-peer (P2P) energy trading, optimal power flow (OPF), and operating limits. SHEMS are indispensable tools that optimize energy usage, facilitate DERs’ operation, manage ESSs and electric vehicles (EVs), and aid demand response (DR) programs. Nevertheless, their dynamic nature presents challenges for distribution transformers, which must adapt to varying loads and energy profiles. The transactive energy framework (TEF) provides a promising approach to managing these interactions, enabling efficient energy transactions and grid optimization. Through a synthesis of existing literature, technological advancements, and case studies, this review paper offers in-depth insights into the design, deployment, and optimization of SHEMS within the scope of smart grids and transactive energy systems. It also investigates the influence of aggregators in coordinating energy transactions, the potential of P2P energy trading for decentralized energy exchange, and the application of OPF and dynamic operating limits for grid stability and reliability. The ultimate purpose of this paper is to contribute to advancing energy management practices and achieving a sustainable and resilient energy future. © 2025 Elsevier Ltd},
	author_keywords = {Distribution network constraints; Distribution transformer; Peer-to-peer trading; Smart homes; Transactive energy framework},
	keywords = {Power management (telecommunication); Voltage scaling; Distribution network constraint; Distribution transformer; Energy; Network constraints; Peer to peer; Peer-to-peer trading; Smart home energy management systems; Smart homes; Storage systems; Transactive energy framework; conceptual framework; electric vehicle; energy efficiency; energy management; energy storage; optimization; smart city; sustainability},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Eldoromi2025,
	author = {Eldoromi, Mojtaba and Birjandi, Ali Akbar Moti and Mahdian Dehkordi, Nima Mahdian},
	title = {Anti-windup control strategy for interlinking converters in hybrid AC/DC microgrids with EV charging stations},
	year = {2025},
	journal = {Electric Power Systems Research},
	volume = {247},
	pages = {},
	doi = {10.1016/j.epsr.2025.111800},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004421444&doi=10.1016%2Fj.epsr.2025.111800&partnerID=40&md5=365bc43d9adfd1b2dae27f3c8607cbcf},
	affiliations = {Shahid Rajaee Teacher Training University, Department of Electrical Engineering, Tehran, Iran},
	abstract = {This paper presents an anti-windup-based control strategy to enhance stability in hybrid AC/DC microgrids (HMGs) integrated with electric vehicle (EV) charging stations. Existing studies have often overlooked the compounded effects of bidirectional power flows and the dynamic nature of EV charging loads on system stability. The proposed strategy focuses on the interlinking converter (ILC) and employs an anti-windup (AW) mechanism combined with proportional-integral (PI) control to address stability issues caused by bidirectional power flows, variable load demands, and low DC-link voltage fluctuations. To fine-tune the AW and PI gains, a particle swarm optimization (PSO) algorithm is used, ensuring robust control performance that responds effectively to fluctuating power inputs from EV chargers. Compared to existing methods, this approach stabilizes power sharing between AC and DC sub-grids, reduces voltage fluctuations, enhances transient response, and minimizes grid current total harmonic distortion (THD). Simulation results validate the effectiveness of the control strategy, highlighting its capability to maintain microgrid (MG) stability under dynamic conditions and varied operating scenarios. The study affirms the feasibility of AW control for HMGs, offering a reliable solution for resilient energy distribution in modern electrical grids. © 2025},
	author_keywords = {Anti-windup control; Electric vehicle charging stations; Hybrid AC/DC micogrid; Interlinking converter; Power quality; Power sharing},
	keywords = {Control system stability; DC distribution systems; DC power transmission; Electric load flow; Electric load management; Electric power plant loads; Electric power system control; Electric power transmission networks; Hybrid vehicles; Lyapunov methods; Microgrids; Power distribution networks; Robust control; Robustness (control systems); Transient analysis; Anti-windup control; Charging station; Control strategies; Electric vehicle charging; Electric vehicle charging station; Hybrid AC/DC micogrid; Interlinking converter; Microgrid; Power; Power sharing; Particle swarm optimization (PSO)},
	type = {Article},
