	title = {Distributed Peer-to-Peer Coordination of Hierarchical Three-Phase Energy Transactions among Electric Vehicle Charging Stations in Constrained Power Distribution and Urban Transportation Networks},
	year = {2024},
	journal = {IEEE Transactions on Transportation Electrification},
	volume = {10},
