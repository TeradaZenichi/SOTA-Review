@ARTICLE{Xia2025,
	author = {Xia, Xiaotang and Li, Tingyang},
	title = {Active/reactive power methodology for modeling charging stations of electric vehicles and optimal locating by peer-to-peer negotiation},
	year = {2025},
	journal = {Journal of Energy Storage},
	volume = {112},
	pages = {},
	doi = {10.1016/j.est.2025.115480},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85215395193&doi=10.1016%2Fj.est.2025.115480&partnerID=40&md5=4d6953b2ee0282a665fe8d2f88d684d2},
	affiliations = {Wuhan University of Science and Technology, School of Urban Construction, Wuhan, Hubei, China; Wuhan University of Science and Technology, Wuhan, Hubei, China; Wuhan Business University, Wuhan, Hubei, China},
	abstract = {This paper presents a novel optimization approach for the placement of electric vehicle charging stations in power distribution networks, integrating active and reactive power optimization to minimize energy losses. The proposed methodology leverages a combination of Battery Energy Storage Systems and Peer-to-Peer negotiation techniques for energy dispatching, which enhances the overall efficiency of charging station operations. Unlike traditional methods, which often overlook the interactions between multiple charging stations, the proposed model addresses these complexities by allowing energy exchange between stations, optimizing both active and reactive power flows. In addition, the paper introduces an innovative framework for integrating battery energy storage systems into the system, which helps in managing off-peak energy storage and mitigating the impact of high electricity prices during peak demand periods. The paper's contributions are threefold: first, it introduces a comprehensive optimization model that incorporates both battery energy storage systems and peer-to-peer negotiation for charging station management; second, it compares the proposed method with existing approaches, demonstrating its superiority in minimizing power losses and improving system efficiency; and third, it provides a detailed financial analysis, showing that the proposed model can lead to a 2.8 % annual return on investment for charging station operators. Numerical results validate the effectiveness of the proposed methodology. For instance, the optimization of charging station placement resulted in a 72.5 % reduction in power loss under uniform load conditions and a 29.6 % decrease in power loss when two charging stations were implemented. © 2025 Elsevier Ltd},
