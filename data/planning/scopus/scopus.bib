@ARTICLE{Zheng2025,
	author = {Zheng, Chutao and Dai, Qiaoling and Chen, Zenggang and Peng, Jianrong and Guo, Guowei and Lin, Diwei and Ye, Qi},
	title = {Application of Mobile Soft Open Points to Enhance Hosting Capacity of EV Charging Stations},
	year = {2025},
	journal = {Energies},
