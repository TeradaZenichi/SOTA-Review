@ARTICLE{Dharavat20221637,
	author = {Dharavat, Nagaraju and Sudabattula, Sureshkumar Kumar and Velamuri, Suresh},
	title = {Optimal Integration of Distributed Generators (DGs) Shunt Capacitors (SCs) and Electric Vehicles (EVs) in a Distribution System (DS) using Marine Predator Algorithm},
	year = {2022},
	journal = {International Journal of Renewable Energy Research},
	volume = {12},
