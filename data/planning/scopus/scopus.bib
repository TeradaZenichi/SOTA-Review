	title = {Mitigation of Voltage Magnitude Profiles Under High-Penetration-Level Fast-Charging Stations Using Optimal Capacitor Placement Integrated with Renewable Energy Resources in Unbalanced Distribution Networks},
	year = {2025},
	journal = {Smart Cities},
