	author = {Guo, Liangsong and Jin, Ming and Jing, Bin and Lv, Leilei and Guo, Min and Ding, Hao and Zhang, Jiabin and Wang, Jianping},
	title = {A multi-objective spatio-temporal pricing method for fast-charging stations oriented to transformer load balancing},
	year = {2024},
