	doi = {10.1088/2631-8695/addd61},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007913999&doi=10.1088%2F2631-8695%2Faddd61&partnerID=40&md5=ea102dda2ed7f869f25bacf64c4c383e},
	affiliations = {Malnad College of Engineering, Department of e & e Engneering, Hassan, KA, India; Malnad College of Engineering, Hassan, KA, India; Sir M Visvesvaraya Institute of Technology, Department of E & E, Bengaluru, KA, India},
	abstract = {Electric Vehicles (EVs) are gaining popularity because of their low carbon emissions, becoming a preferred mode of transport in both rural and urban areas. However, the growing number of EVs puts significant load to the grid, leading to increased voltage fluctuations and higher active and reactive power losses. More EV loads lead to overloading of distribution transformers and feeders thereby affects the system stability. Photovoltaic (PV) integration enhances grid performance by delivering clean, decentralized power generation, thereby reducing transmission losses and increasing overall efficiency. Thus to enhance grid stability, integrating Photovoltaics (PVs) into the distribution system is essential. Electric vehicles draw electricity from charging stations. Therefore, in this journal, EV location refers to the location of Electric Vehicle Charging Stations(EVCS). Proper placement of EVs and PVs within the grid can significantly reduce power losses. This work proposes a hybrid metaheuristic algorithm that combines Harris Hawk Optimization (HHO) with Grey Wolf Optimization (GWO) to find optimal locations, aiming to minimize power losses and improve bus voltage profiles. This study uses MATLAB simulations on IEEE 15-bus, 12-bus, 69-bus and a real-time 26-bus network to identify optimal bus locations for EVs and PVs. This study examines eight scenarios for integrating EVs and PV systems. Given that EVs and PVs are still emerging in India, this analysis will significantly benefit distribution system operators and address current needs. A key feature of this research is its utilization of real-time data from a distribution grid of a small town in India. The percentage decrease in power losses using GWO, HHO, and the hybrid GWO-HHO (HGHO) algorithm was compared. The HGHO algorithm exhibited superior performance compared to individual methods, achieving significant reductions in power losses and notable improvements in the bus voltage profile. © 2025 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved.},
	author_keywords = {bus voltage deviation; distribution system losses; electric vehicle integration; metaheuristic algorithms},
