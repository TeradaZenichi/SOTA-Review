	title = {Analytical Probabilistic Power Flow and Global Sensitivity Analysis of Distribution Systems Based on Gaussian Mixture Model of Input-Output Variables},
	year = {2024},
	journal = {IEEE Transactions on Power Systems},
	volume = {39},
	number = {3},
	pages = {5283 - 5296},
	doi = {10.1109/TPWRS.2023.3329197},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85181833547&doi=10.1109%2FTPWRS.2023.3329197&partnerID=40&md5=bc1f9ea2de8a9470dd58e67dd231a3cb},
	affiliations = {Shanghai Jiao Tong University, Key Laboratory of Control of Power Transmission and Conversion, Shanghai, China; Shanghai Non-carbon Energy Conversion and Utilization Institute, Shanghai, Shanghai, China; Shanghai Jiao Tong University, College of Smart Energy, Shanghai, China; Key Laboratory of System Control and Information Processing, Ministry of Education, Shanghai, China; Shanghai Engineering Research Center of Intelligent Control and Management, Shanghai, Shanghai, China},
	abstract = {This paper proposes a computationally efficient and accurate method to solve probabilistic power flow (PPF) and its global sensitivity analysis (GSA) problems of power distribution systems. A distinguishing feature of this study is that a closed-form expression of the joint probability distribution function (PDF) of random input and output variables of distribution system power flow is derived based on the Gaussian mixture model (GMM), and then both PPF and GSA problems are calculated analytically. First, we combine kernel density estimation with the density-preserving hierarchical expectation maximization algorithm to obtain the GMM of random input variables, which describes their non-Gaussian distributions and correlations. Second, to characterize the nonlinear mapping relationship from inputs to outputs in power flow calculation, we establish the joint PDF of random input and output variables using the GMM of input variables and a piecewise linear power flow model, and then derive the closed-form PPF and semi-closed-form GSA solutions. Third, we develop a GMM-based decomposition method of global sensitivity indices to identify correlation effects and individual effects of correlated input variables on power flow variations. The proposed method is tested on the IEEE 33-bus and 123-bus distribution systems integrated with photovoltaic power units, wind turbines, and electric vehicle charging stations. Numerical results show that the proposed method is both fast and accurate, and superior over state-of-the-art surrogate model-based PPF and GSA methods. © 1969-2012 IEEE.},
	author_keywords = {distribution system; Gaussian mixture model; global sensitivity analysis; piecewise linearization; probabilistic power flow; Uncertainty quantification},
	keywords = {Distribution functions; Electric load flow; Electric power distribution; Gaussian distribution; Image segmentation; Maximum principle; Numerical methods; Piecewise linear techniques; Uncertainty analysis; Computational modelling; Correlation; Distribution systems; Gaussian Mixture Model; Global sensitivity analysis; Input variables; Load flow; Piecewise linearization; Probabilistic power flow; Probability: distributions; Uncertainty; Uncertainty quantifications; Probability density function},
