	keywords = {DC distribution systems; Electric load distribution; Network theory (graphs); Fast charging stations; Graph characterizations; Load transfer; Load transfer optimization; Multi-voltage; Multi-voltage distribution network; Multiple time scale; Optimisations; Optimization approach; Voltage distribution; Fast charging (Batteries)},
