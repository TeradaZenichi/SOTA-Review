	number = {21},
	pages = {},
	doi = {10.3390/en18215758},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021652435&doi=10.3390%2Fen18215758&partnerID=40&md5=f6196a0329b2400b2dcf1468dcbcdf2a},
	affiliations = {Guangdong Power Grid Corporation, Guangzhou, Guangdong, China; South China University of Technology, School of Electronic and Information Engineering, Guangzhou, Guangdong, China},
	abstract = {The rapid growth of electric vehicle (EV) charging demand poses significant challenges to distribution networks (DNs), particularly during public holidays when concentrated peaks occur near scenic areas and urban transport hubs. These sudden surges can strain transformer capacity and compromise supply reliability. Fixed soft open points (SOPs) are costly and underutilized, limiting their effectiveness in DNs with multiple transformers and asynchronous peak loads. To address this, from the perspective of power supply companies, this study proposes a mobile soft open point (MSOP)-based approach to enhance the hosting capacity of EV charging stations. The method pre-installs a limited number of fast-access interfaces (FAIs) at candidate transformers and integrates a semi-rolling horizon optimization framework to gradually expand interface availability while scheduling MSOPs daily. An automatic peak period identification algorithm ensures optimization focuses on critical load periods. Case studies on a multi-feeder distribution system coupled with a realistic traffic network demonstrate that the proposed method effectively balances heterogeneous peak loads, matches limited interfaces with MSOPs, and enhances system-level hosting capacity. Compared with fixed SOP deployment, the strategy improves hosting capacity during peak periods while reducing construction costs. The results indicate that MSOPs provide a practical, flexible, and economically efficient solution for power supply companies to manage concentrated holiday charging surges in DNs. © 2025 by the authors.},
	author_keywords = {charging stations (CSs); distribution networks (DNs); fast-access interfaces (FAIs); hosting capacity; mobile soft open points (MSOPs); peak load management},
	keywords = {Charging (batteries); Electric load distribution; Electric power distribution; Optimization; Urban growth; Urban transportation; Charging station; Distribution network; Electric vehicle charging; Fast-access interface; Hosting capacity; Mobile soft open point; Peak load; Peak load management; Power supply company; Charging stations},
