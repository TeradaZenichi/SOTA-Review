@ARTICLE{Nurmuhammed202381,
	author = {Nurmuhammed, Mustafa and Akdaǧ, Ozan and Karadag, Teoman},
	title = {A novel modified Archimedes optimization algorithm for optimal placement of electric vehicle charging stations in distribution networks},
	year = {2023},
	journal = {Alexandria Engineering Journal},
	volume = {84},
