	keywords = {Electric load flow; Electric power transmission networks; Electric vehicles; Second-order cone programming; Stochastic models; Stochastic systems; Vehicle-to-grid; Carsharing; Demand uncertainty; Distribution systems; Locational marginal prices; Marginal prices; Price-based; Siting and sizings; Stochastic optimizations; System operator; Two-stage stochastic optimization; Profitability; distribution system; electric vehicle; optimization; profitability; stochasticity; uncertainty analysis},
