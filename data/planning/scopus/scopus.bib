@ARTICLE{Caneponi2019605,
	author = {Caneponi, Giulio and Cazzato, Fabio and Cochi, S. and Di Clerico, Marco and Falvo, Maria Carmen and Manganelli, Matteo},
	title = {EV charging stations and RES-based DG: A centralized approach for smart integration in active distribution grids},
	year = {2019},
	journal = {International Journal of Renewable Energy Research},
