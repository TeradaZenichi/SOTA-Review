@article{ WOS:000769985100008,
Author = {Feizi, Mohammad Ramin and Khodayar, Mohammad E. and Chen, Bo},
Title = {Feasible Dispatch Limits of PV Generation With Uncertain Interconnection
   of EVs in the Unbalanced Distribution Network},
Journal = {IEEE TRANSACTIONS ON VEHICULAR TECHNOLOGY},
Year = {2022},
Volume = {71},
Number = {3},
Pages = {2267-2280},
Month = {MAR},
Abstract = {This paper presents a framework to determine the feasible dispatch
   limits of solar photovoltaic (PV) generation in the unbalanced
   distribution network considering the interconnection of electric
   vehicles (EVs) and associated uncertainties. The proposed framework
   determines the lower and upper dispatch limits of PV generation
   considering the worst-case realization of a) the minimum and maximum
   storage capacity of EVs, b) the minimum and maximum power dispatch of
   EVs, c) the lower and upper bounds for the arrival and departure times,
   and d) the available energy at arrival and departure times. The
   unbalanced operation of the distribution network as well as the
   uncertainty in the maximum PV generation and demand forecasts were
   considered. The problem formulation and solution approach are validated
   using the modified IEEE 34-bus and IEEE 123-bus distribution systems.
   The impacts of the budget of uncertainty and the vehicle-to-grid
   operation mode of EV clusters were addressed in the case studies. It is
   shown that integrating EVs with charging capability will increase the
   lower dispatch limit or increase the upper dispatch limit of the PV
   generation. Moreover, the increase in the budget of uncertainty will
   reduce the difference between the upper and lower dispatch limits by
   increasing the lower dispatch or decreasing the upper dispatch limit of
   the PV generation. Finally, it is shown that the vehicle-to-grid
   capability will reduce the total lower dispatch limit or increase the
   total upper dispatch limit of the PV generation in the operation
   horizon.},
Type = {Article},
Affiliation = {Feizi, MR (Corresponding Author), Southern Methodist Univ, Dept Elect \& Comp Engn, Dallas, TX 75205 USA.
   Feizi, Mohammad Ramin; Khodayar, Mohammad E., Southern Methodist Univ, Dept Elect \& Comp Engn, Dallas, TX 75205 USA.
   Chen, Bo, Argonne Natl Lab, Energy Syst Div, Lemont, IL 60439 USA.},
DOI = {10.1109/TVT.2021.3096459},
Keywords = {Uncertainty; Distribution networks; Voltage control; Security; Reactive
   power; Reliability; Distributed power generation; Dispatchable limit;
   electric vehicle; solar PV generation},
Keywords-Plus = {LV DISTRIBUTION NETWORKS; HOSTING CAPACITY; DISTRIBUTION-SYSTEMS;
   ELECTRIC VEHICLES; STORAGE-SYSTEMS; LOAD; ALLOCATION; INVERTERS},
Research-Areas = {Engineering; Telecommunications; Transportation},
Author-Email = {mfeizi@smu.edu
   mkhodayar@mail.smu.edu
   bo.chen@anl.gov},
Funding-Acknowledgement = {National Science Foundation {[}ECCS-1710923]; U.S. Department of
   Energy'sOffice of Energy Efficiency and Renewable Energy (EERE) under
