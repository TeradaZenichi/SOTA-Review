Keywords = {Electric vehicle charging; Renewable energy sources; Security;
   Mathematical models; Power systems; Generators; Load modeling; Capacity
   evaluation; demand response (DR); electric vehicle (EV); electric
   vehicle chargeable area (EVCA)},
