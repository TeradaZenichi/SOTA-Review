@article{ WOS:001583118100001,
Author = {Yang, Yue and Gao, Shan and Wang, Jianing and Huang, Xueliang},
Title = {A spatiotemporal coordinated regulation strategy for electric vehicles
   to enhance distribution network hosting capacity},
Journal = {ELECTRIC POWER SYSTEMS RESEARCH},
Year = {2026},
Volume = {251},
Month = {FEB},
Abstract = {To address the flexibility limitations and hosting capacity constraints
   of distribution network (DN) under largescale electric vehicles (EVs)
   integration, this paper proposes a spatiotemporal coordinated regulation
   strategy. The strategy optimizes both time and space dimensions to
   leverage the regulation potential of different EV types. Temporally, a
   personalized charging/discharging schedule is generated for private EVs
   using an enhanced Proximal Policy Optimization (PPO) algorithm, with a
   soft projection mechanism ensuring strict adherence to safety
   constraints. Spatially, a utility-based charging station selection model
   is developed for taxis, and a differential evolution algorithm is
   employed to derive spatially differentiated pricing incentives, guiding
   the rational spatial distribution of taxis charging loads. Simulation
   results on the modified IEEE33 and IEEE123-bus systems demonstrate that
   the proposed spatiotemporal coordinated regulation strategy effectively
   enhances the distribution network hosting capacity (DNHC).},
Type = {Article},
Affiliation = {Gao, S (Corresponding Author), Southeast Univ, Sch Elect Engn, Nanjing 210018, Peoples R China.
   Yang, Yue; Gao, Shan; Wang, Jianing; Huang, Xueliang, Southeast Univ, Sch Elect Engn, Nanjing 210018, Peoples R China.},
DOI = {10.1016/j.epsr.2025.112260},
EarlyAccessDate = {SEP 2025},
