@article{ WOS:001136962300001,
Author = {Khan, Mohd Owais and Kirmani, Sheeraz and Rihan, Mohd and Pandey, Anand
   Kumar},
Title = {Stochastic Modelling and Integration of Electric Vehicles in the
   Distribution System Using the Jaya Algorithm},
